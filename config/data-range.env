# Controls how much NYC TLC data the producer streams into Kafka.
# Brief asks for "all files dating back to 2020" — see README "Trade-offs".
# Override these to widen the range; default is a small slice for laptop demo.

YEAR_START=2024
MONTH_START=1
YEAR_END=2024
MONTH_END=3
TAXI_TYPES=yellow, green

# Source: https://d37ci6vzurychx.cloudfront.net/trip-data/{type}_tripdata_YYYY-MM.parquet
PARQUET_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
